{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "JARVIS (servidor + interface)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "JARVIS (conversa no terminal)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["--cli"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "JARVIS (verificar configuração)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["--check"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
