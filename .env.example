# ============================================================
# JARVIS — configuração. Copie para .env e preencha.
# NUNCA envie o .env para o GitHub (ele já está no .gitignore).
# ============================================================

# ---------- Modelo de IA ----------
# Provedores: openai | groq | openrouter | lmstudio | ollama | anthropic | none
MODEL_PROVIDER=groq
# Nome do modelo no provedor. Confira a lista atual na documentação do provedor
# Groq (grátis para começar, console.groq.com): openai/gpt-oss-120b ou llama-3.3-70b-versatile.
MODEL_NAME=openai/gpt-oss-120b
API_KEY=
# Opcional: endereço próprio (ex.: http://localhost:11434 para Ollama em outra porta)
MODEL_BASE_URL=
# Opcional: deixe vazio para usar a temperatura padrão do modelo
MODEL_TEMPERATURE=
MODEL_TIMEOUT=60

# ---------- Identidade ----------
USER_NAME=José Marcelo
LANGUAGE=pt-BR

# ---------- Armazenamento ----------
DATABASE_PATH=database/memory.db
WORKSPACE_DIR=workspace
LOG_PATH=logs/jarvis.log

# ---------- Pesquisa ----------
# Wikipedia, GitHub e arXiv funcionam SEM chave.
# Para web geral e NOTÍCIAS, configure UM destes (ambos têm plano gratuito):
#   Tavily: https://tavily.com      Brave Search API: https://brave.com/search/api/
TAVILY_API_KEY=
BRAVE_API_KEY=
# Opcional: aumenta o limite de buscas no GitHub
GITHUB_TOKEN=

# ---------- Voz ----------
# TTS_PROVIDER=edge usa vozes neurais (pip install edge-tts; precisa de internet).
#   Vozes pt-BR: pt-BR-AntonioNeural (masculina), pt-BR-FranciscaNeural (feminina), pt-BR-ThalitaNeural
# TTS_PROVIDER=browser usa a voz do navegador.
TTS_PROVIDER=edge
TTS_VOICE=pt-BR-AntonioNeural
# STT_PROVIDER=browser usa o reconhecimento de fala do Chrome/Edge (o áudio vai para o serviço do navegador).
# STT_PROVIDER=whisper transcreve no seu PC (pip install faster-whisper; precisa de PC bom).
STT_PROVIDER=browser
WHISPER_MODEL=small

# ---------- Permissões ----------
# Risco baixo (pesquisar, calcular, ler, criar arquivo novo, abrir site): automático.
# Risco alto (apagar, sobrescrever, ações irreversíveis): SEMPRE pede confirmação.
# Risco médio (abrir programas): allow = automático | confirm = pergunta antes
PERMISSION_MEDIUM=allow

# ---------- Servidor ----------
HOST=127.0.0.1
PORT=8000
DEBUG=false
HISTORY_LIMIT=12
